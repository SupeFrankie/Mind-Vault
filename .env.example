# Copy to .env and fill in. Never commit .env.
DJANGO_SECRET_KEY=change-me-generate-with-the-command-in-README
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Production only (https origins, comma separated), e.g. https://yourname.pythonanywhere.com
DJANGO_CSRF_TRUSTED_ORIGINS=

DB_NAME=mindvault
DB_USER=mindvault
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_PORT=3306

# Where uploaded files live. MUST be outside any publicly served directory.
MEDIA_ROOT=/home/youruser/mindvault_media
